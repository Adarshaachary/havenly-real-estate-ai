generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                  String      @id @default(auto()) @map("_id") @db.ObjectId
  email               String      @unique
  name                String?
  bookedVisits        Json
  favResidenceiesID   String[]
  residencies         Residency[]
}

model Residency {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId

  title           String?
  description     String?
  propertyType    String?
  price           Float?

  address         String
  country         String?
  city            String?

  image           String?
  images          String[]

  facilities      Json?
  area            Float?
  plotArea        Float?
  yearBuilt       Int?
  furnishing      String?
  amenities       Json?

  latitude        Float?
  longitude       Float?
  nearbyPlaces    Json?

  availability    String?
  status          String?

  userEmail       String

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  owner           User      @relation(fields: [userEmail], references: [email])

  @@unique([address, userEmail])
}